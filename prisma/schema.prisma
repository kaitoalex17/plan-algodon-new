generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // ADMIN or USER
  color         String    @default("#000000")
  tokenVersion  Int       @default(1)
  lastLogin     DateTime?
  lastLat       Float?
  lastLng       Float?
  lastZoom      Int?
  zoomThreshold Int       @default(12)
  theme         String    @default("orange")
  markerShape   String    @default("circle")
  markerSize    Int       @default(6)
  showProgramadas Boolean @default(true)
  mapLayer        String  @default("https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}")
  patternCorrecto String  @default("diagonal-stripes")
  patternFallo    String  @default("cross-pattern")
  assignedCTOs  CTO[]     @relation("AssignedTo")
  createdCTOs   CTO[]     @relation("CreatedBy")
  auditedCTOs   CTO[]     @relation("AuditedBy")
  comments      Comment[]
  history       History[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CTO {
  id             String    @id @default(cuid())
  num            String    // This maps to "Número" in the Excel
  numeroNuevo    String?   // "NumeroNuevo"
  coordenadas    String    // Original string "lat, lng"
  lat            Float
  lng            Float
  municipio      String?
  colocacion     String?
  fechaAgregacion DateTime?
  notas          String?
  category       String    @default("AUDITORIA") // AUDITORIA, PROGRAMADA
  createdById    String?
  createdBy      User?     @relation("CreatedBy", fields: [createdById], references: [id])
  createdInField Boolean   @default(false)
  zona           String?
  cluster        String?
  
  // Datos específicos de auditoría de fibra
  puertosTotal      Int?      @default(16)
  puertosOcupados   Int?      @default(0)
  potenciaDbm       Float?
  cierreSeguridad   Boolean?  @default(true)
  etiquetadoCorrecto Boolean? @default(true)

  status         String    @default("PENDIENTE") // PENDIENTE, CORRECTO, FALLO
  subStatusId    String?
  subStatus      SubStatus? @relation(fields: [subStatusId], references: [id])

  assignedToId   String?
  assignedTo     User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  auditedById    String?
  auditedBy      User?     @relation("AuditedBy", fields: [auditedById], references: [id])
  hasFormulario  Boolean   @default(false)
  hasDrive       Boolean   @default(false)
  hasAntala      Boolean   @default(false)
  formDataJson   String?
  urlFicha       String?
  driveSyncStatus String   @default("NONE") // NONE, SYNCED, ERROR
  driveFolderLink String?

  comments       Comment[]
  images         Image[]
  history        History[]
  alerts         Alert[]
}

model SubStatus {
  id       String @id @default(cuid())
  name     String
  color    String @default("#808080")
  category String @default("AUDITORIA") // AUDITORIA, PROGRAMADA
  ctos     CTO[]
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  ctoId     String
  cto       CTO      @relation(fields: [ctoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Image {
  id        String   @id @default(cuid())
  url       String
  ctoId     String
  cto       CTO      @relation(fields: [ctoId], references: [id], onDelete: Cascade)
}

model History {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  location  String?  // Where it was modified (e.g. coordinates or IP)
  ctoId     String
  cto       CTO      @relation(fields: [ctoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Alert {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
  ctoId     String
  cto       CTO      @relation(fields: [ctoId], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id
  value String
}
